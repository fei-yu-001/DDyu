# Derived image: reuse the published lab frontend and base layer, replace only
# the backend binary with the locally built, patched one.
#
# Build:
#   docker build -f Dockerfile.derived -t grok2api-lab:v3.1.9-lab .
#
# The binary must be built for linux/amd64:
#   cd backend && CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
#     go build -buildvcs=false -trimpath -ldflags="-s -w" -o ../dist/grok2api-patched ./cmd/grok2api

FROM ghcr.io/lij768423-svg/grok2api:latest

COPY dist/grok2api-patched /app/grok2api
COPY VERSION /app/VERSION

# Base image already sets ENTRYPOINT/CMD/HEALTHCHECK/EXPOSE and the
# grok2api user; only the binary and version label change.
