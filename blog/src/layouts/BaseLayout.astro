---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  type?: "website" | "article";
}

const { title, description, type = "website" } = Astro.props;
const site = Astro.site;
const url = site ? new URL(Astro.url.pathname, site) : undefined;
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description ?? ""} />
    {url && <link rel="canonical" href={url.href} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="DDyu" href="/rss.xml" />
    {url && (
      <>
        <meta property="og:type" content={type} />
        <meta property="og:url" content={url.href} />
        <meta property="og:site_name" content="DDyu" />
        <meta property="og:title" content={title} />
        {description && <meta property="og:description" content={description} />}
        <meta name="twitter:card" content="summary" />
      </>
    )}
    <script is:inline>
      // 深色模式：优先 localStorage，否则跟随系统；首屏前执行避免闪烁。
      (function () {
        var stored = localStorage.getItem("theme");
        var dark = stored
          ? stored === "dark"
          : window.matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.classList.toggle("dark", dark);
      })();
      // 壁纸明显度：与创意工坊共用（个人中心可改），首屏前执行避免闪烁。
      (function () {
        var stored = localStorage.getItem("ddyu:bg-prominence");
        if (stored === null) return;
        var value = Number(stored);
        if (Number.isFinite(value) && value >= 0 && value <= 100) {
          document.documentElement.style.setProperty("--bg-veil", String(1 - value / 100));
        }
      })();
    </script>
  </head>
  <body class="flex min-h-screen flex-col bg-slate-50 text-slate-900 antialiased dark:bg-slate-950 dark:text-slate-100">
    <header class="border-b border-slate-200 dark:border-slate-800">
      <div class="relative mx-auto flex w-full max-w-[1280px] items-center justify-between px-4 py-4">
        <a href="/" class="text-2xl font-semibold tracking-tight">DDyu</a>
        <!-- 桌面端：三个链接在头部正中（绝对定位居中，不受 logo 宽度影响） -->
        <nav class="absolute left-1/2 hidden -translate-x-1/2 items-center gap-6 text-xl md:flex">
          <a href="/" class="text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-100">
            首页
          </a>
          <a href="/about/" class="text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-100">
            关于
          </a>
          <a href="/studio/" class="text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-100">
            创意工坊
          </a>
        </nav>
        <div class="flex items-center gap-3 md:gap-4">
          <nav class="flex items-center gap-4 text-xl md:hidden">
            <a href="/" class="text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-100">
              首页
            </a>
            <a href="/about/" class="text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-100">
              关于
            </a>
            <a href="/studio/" class="text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-100">
              创意工坊
            </a>
          </nav>
          <!-- 我们的故事（仅管理员可见，脚本确认后显示）：我俩头像并排、标签在下方居中，点任一头像都进日记页 -->
          <a id="story-entry" href="/story/" class="hidden flex-col items-center gap-1" title="我们的故事">
            <span class="flex items-center gap-1.5">
              <img src="/qiqi-avatar.jpg" alt="七七" class="size-6 rounded-full object-cover ring-1 ring-slate-300/80 dark:ring-slate-600/80 md:size-8" />
              <img src="/feige-avatar.jpg" alt="斐哥" class="size-6 rounded-full object-cover ring-1 ring-slate-300/80 dark:ring-slate-600/80 md:size-8" />
            </span>
            <span class="hidden text-xs leading-none text-slate-500 dark:text-slate-400 md:block">我们的故事</span>
          </a>
          <!-- 设置齿轮（全局入口，与创意工坊一致）：外观 / 个人中心 / 参数调节 / 退出（管理员）或登录（访客） -->
          <div class="relative">
            <button id="settings-trigger" type="button" aria-label="设置" aria-haspopup="menu" aria-expanded="false" class="rounded-md p-1.5 text-slate-600 hover:bg-slate-200/70 dark:text-slate-400 dark:hover:bg-slate-800">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="block h-5 w-5">
                <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.21.36a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.21.36a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.21-.36a2 2 0 0 0-.73-2.73l-.15-.1a2 2 0 0 1-1-1.72v-.51a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.21-.36a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z" />
                <circle cx="12" cy="12" r="3" />
              </svg>
            </button>
            <div id="settings-panel" role="menu" aria-hidden="true" class="invisible absolute right-0 top-full z-50 mt-1.5 w-44 rounded-lg border border-slate-200 bg-white p-1.5 opacity-0 shadow-lg transition-opacity duration-150 dark:border-slate-700 dark:bg-slate-900">
              <button type="button" role="menuitem" data-theme="light" class="flex w-full items-center gap-2 rounded-md px-2.5 py-2 text-left text-sm text-slate-700 transition-colors hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-800">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4 shrink-0 text-slate-500 dark:text-slate-400"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" /></svg>
                浅色
              </button>
              <button type="button" role="menuitem" data-theme="dark" class="flex w-full items-center gap-2 rounded-md px-2.5 py-2 text-left text-sm text-slate-700 transition-colors hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-800">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4 shrink-0 text-slate-500 dark:text-slate-400"><path d="M12 7a5 5 0 1 0 5 5 7 7 0 1 1-5-5z" /></svg>
                深色
              </button>
              <button type="button" role="menuitem" data-theme="system" class="flex w-full items-center gap-2 rounded-md px-2.5 py-2 text-left text-sm text-slate-700 transition-colors hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-800">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4 shrink-0 text-slate-500 dark:text-slate-400"><rect width="20" height="14" x="2" y="3" rx="2" /><line x1="8" x2="16" y1="21" y2="21" /><line x1="12" x2="12" y1="17" y2="21" /></svg>
                跟随系统
              </button>
              <div class="my-1.5 h-px bg-slate-200 dark:bg-slate-700"></div>
              <a id="menu-profile" role="menuitem" href="/studio/profile" class="hidden flex w-full items-center gap-2 rounded-md px-2.5 py-2 text-left text-sm text-slate-700 transition-colors hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-800">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4 shrink-0 text-slate-500 dark:text-slate-400"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                个人中心
              </a>
              <a id="menu-settings" role="menuitem" href="/studio/settings" class="hidden flex w-full items-center gap-2 rounded-md px-2.5 py-2 text-left text-sm text-slate-700 transition-colors hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-800">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4 shrink-0 text-slate-500 dark:text-slate-400"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.21.36a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.21.36a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.21-.36a2 2 0 0 0-.73-2.73l-.15-.1a2 2 0 0 1-1-1.72v-.51a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.21-.36a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z" /><circle cx="12" cy="12" r="3" /></svg>
                参数调节
              </a>
              <button id="menu-logout" type="button" role="menuitem" class="hidden flex w-full items-center gap-2 rounded-md px-2.5 py-2 text-left text-sm text-slate-700 transition-colors hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-800">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4 shrink-0 text-slate-500 dark:text-slate-400"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><polyline points="16 17 21 12 16 7" /><line x1="21" x2="9" y1="12" y2="12" /></svg>
                退出登录
              </button>
              <a id="menu-login" role="menuitem" href="/studio/login" class="flex w-full items-center gap-2 rounded-md px-2.5 py-2 text-left text-sm text-slate-700 transition-colors hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-800">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4 shrink-0 text-slate-500 dark:text-slate-400"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4" /><polyline points="10 17 15 12 10 7" /><line x1="3" x2="15" y1="12" y2="12" /></svg>
                登录
              </a>
            </div>
          </div>
        </div>
      </div>
    </header>
    <script>
      // 设置齿轮：开合菜单、外观切换（与创意工坊共用 localStorage.theme）、管理员/访客菜单项。
      // 管理员会话检查：有会话时显示「我们的故事」入口与管理员菜单项；访客保持默认。
      // access cookie 的 path 收敛在 /api/admin/v1。
      (() => {
        const trigger = document.getElementById("settings-trigger");
        const panel = document.getElementById("settings-panel");
        if (!trigger || !panel) return;

        function setTheme(value) {
          localStorage.setItem("theme", value);
          const dark = value === "dark" || (value === "system" && window.matchMedia("(prefers-color-scheme: dark)").matches);
          document.documentElement.classList.toggle("dark", dark);
        }
        function close() {
          panel.classList.add("invisible", "opacity-0");
          panel.setAttribute("aria-hidden", "true");
          trigger.setAttribute("aria-expanded", "false");
        }
        function open() {
          panel.classList.remove("invisible", "opacity-0");
          panel.setAttribute("aria-hidden", "false");
          trigger.setAttribute("aria-expanded", "true");
        }

        trigger.addEventListener("click", (event) => {
          event.stopPropagation();
          panel.classList.contains("invisible") ? open() : close();
        });
        document.addEventListener("click", (event) => {
          if (!panel.contains(event.target) && event.target !== trigger) close();
        });
        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape") close();
        });

        panel.querySelectorAll("[data-theme]").forEach((btn) => {
          btn.addEventListener("click", () => {
            setTheme(btn.dataset.theme);
            close();
          });
        });

        document.getElementById("menu-logout")?.addEventListener("click", () => {
          fetch("/api/admin/v1/auth/logout", { method: "POST", credentials: "same-origin", body: "{}" })
            .catch(() => {})
            .finally(() => {
              location.href = "/studio/login";
            });
        });

        fetch("/api/admin/v1/me", { credentials: "same-origin" })
          .then((res) => (res.ok ? res.json() : null))
          .then((json) => {
            if (!json?.data?.username) return;
            document.getElementById("story-entry")?.classList.remove("hidden");
            for (const id of ["menu-profile", "menu-settings", "menu-logout"]) {
              document.getElementById(id)?.classList.remove("hidden");
            }
            document.getElementById("menu-login")?.classList.add("hidden");
          })
          .catch(() => {});
      })();
    </script>
    <main class="mx-auto w-full max-w-3xl flex-1 px-4 py-8">
      <slot />
    </main>
    <footer class="border-t border-slate-200 dark:border-slate-800">
      <div class="mx-auto flex w-full max-w-[1280px] items-center justify-between px-4 py-6 text-sm text-slate-500 dark:text-slate-400">
        <span>DDyu © {year}</span>
        <a href="/rss.xml" class="hover:text-slate-800 dark:hover:text-slate-200">RSS</a>
      </div>
    </footer>
  </body>
</html>
